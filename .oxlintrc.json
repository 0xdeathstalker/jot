{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "jsx-a11y"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "react/no-array-index-key": "warn",
    "typescript/no-explicit-any": "warn",
    "prefer-const": "error",
    "jsx-a11y/label-has-associated-control": [
      "error",
      { "controlComponents": ["Input", "Checkbox", "Radio", "Switch", "Textarea"] }
    ]
  },
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "import/no-relative-parent-imports": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@tauri-apps/**"],
                "message": "Tauri code lives in src/desktop/, loaded with import() only when isDesktop(), so the web and phone bundles stay free of it (docs/plans/desktop-app.md 3.2)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/desktop/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/editor/**", "src/features/notes/**", "src/hooks/use-note-*.ts"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "Note data is local-first: read and write the Y.Doc, not a server API (docs/project-context.md §13 rule 3)."
          }
        ]
      }
    }
  ]
}
