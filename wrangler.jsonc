/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jot",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-04",
  // Better Auth needs node:async_hooks / node:crypto.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    // Without this the SPA fallback answers GETs with index.html before the Worker runs:
    //  - /api/*: the Google callback is a browser navigation, so login would never complete.
    //  - /parties/*: a WebSocket handshake is a GET, so it would skip the permission guard.
    "run_worker_first": ["/api/*", "/parties/*"],
  },
  // Auth tables + note_members. `pnpm dev` uses a local copy in .wrangler/state; the id below is
  // the real database created by `wrangler d1 create jot-db` (docs/plans/phase-4-auth.md, E1).
  // Keep the binding name `DB`: the Worker code reads env.DB.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jot-db",
      "database_id": "c6caa0ba-8c79-427c-bf59-663acaeacb06",
      "migrations_dir": "worker/migrations",
    },
  ],
  // Custom domain. Cloudflare creates the DNS record and certificate itself on deploy, and refuses
  // if the hostname already has a DNS record (delete any old `jot` record in the dashboard first).
  // workers.dev stays reachable as well.
  "routes": [{ "pattern": "jot.deathstalker.dev", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  // One NoteRoom Durable Object per note, one IndexRoom per user (the note list).
  // Free plan needs SQLite-backed classes.
  // Never edit an existing migration ("v1", "v2"): add a new tag (v3, ...) for any class change.
  "durable_objects": {
    "bindings": [
      {
        "name": "NoteRoom",
        "class_name": "NoteRoom",
      },
      {
        "name": "IndexRoom",
        "class_name": "IndexRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NoteRoom"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["IndexRoom"],
    },
  ],
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  // "vars": {  "MY_VARIABLE": "production_value" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
