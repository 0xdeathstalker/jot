{
  "name": "jot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node -e \"if(!(process.env.npm_config_user_agent||'').startsWith('pnpm/')){console.error('This project requires pnpm. Run: npm i -g pnpm (or corepack enable), then pnpm install.');process.exit(1)}\"",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "typecheck": "wrangler types && tsc -b",
    "check": "oxlint && oxfmt --check && pnpm typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.5",
    "@tiptap/extension-collaboration": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@tiptap/y-tiptap": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "minisearch": "^7.2.0",
    "partyserver": "^0.5.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "y-indexeddb": "^9.0.12",
    "y-partyserver": "^2.2.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.158.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,mjs,json,jsonc,css,html,md,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  }
}
